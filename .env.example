# ==============================================================================
# Mindora AI Environment Variables Template (.env.example)
# Copy this file to .env.local and populate with your own configuration values.
# NEVER put real API keys in this example file.
# ==============================================================================

# Database Connection (PostgreSQL connection string)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindora?schema=public"

# Authentication Secret (Generate a strong random string for production)
AUTH_SECRET="mindora_super_secret_session_token_key_change_in_prod_82947192"

# ------------------------------------------------------------------------------
# Server-Side AI Provider Configuration
# ------------------------------------------------------------------------------
# Available options: demo | openai | anthropic | gemini | groq | deepseek | custom
# Note: If AI_PROVIDER="demo" or AI_API_KEY is left empty, Mindora will seamlessly
# run in Demo Mode with realistic streaming responses.
AI_PROVIDER="demo"

# Your Server-side AI Provider API Key (Kept strictly on server side)
AI_API_KEY=""

# Optional Custom Base URL (Useful for OpenAI-compatible proxies, Groq, Ollama, OpenRouter)
# Examples:
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Ollama     : http://localhost:11434/v1
AI_BASE_URL=""

# Optional Specific Model Override
# Examples:
#   OpenAI    : gpt-4o | gpt-4o-mini | o1-mini
#   Anthropic : claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022
#   Gemini    : gemini-1.5-flash | gemini-1.5-pro | gemini-2.0-flash
#   Groq      : llama-3.3-70b-versatile | llama-3.1-8b-instant
#   DeepSeek  : deepseek-chat | deepseek-reasoner
AI_MODEL=""

# ------------------------------------------------------------------------------
# Public Application Metadata (Safe for client-side consumption)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Mindora"
NEXT_PUBLIC_APP_TAGLINE="Think. Create. Discover."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
